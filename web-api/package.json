{
  "name": "web-api",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "db:generate:migration": "bunx drizzle-kit generate --config=./src/db/drizzle.config.ts",
    "db:migrate": "bunx drizzle-kit migrate --config=./src/db/drizzle.config.ts",
    "db:remove:migration": "bunx drizzle-kit drop --config=./src/db/drizzle.config.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.8.0",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.23",
    "hono-pino": "^0.10.3",
    "postgres": "^3.4.9",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  }
}
